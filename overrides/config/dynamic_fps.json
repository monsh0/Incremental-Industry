{
  "enabled": false,
  "uncap_menu_frame_rate": true,
  "idle": {
    "timeout": 1800,
    "condition": "none"
  },
  "states": {
    "hovered": {
      "frame_rate_target": -1
    },
    "unfocused": {
      "frame_rate_target": -1,
      "show_toasts": true
    },
    "abandoned": {
      "frame_rate_target": -1,
      "show_toasts": true
    },
    "invisible": {
      "show_toasts": true
    },
    "unplugged": {
      "enable_vsync": false
    }
  }
}
